namespace Costas32

/-!
A theorem-name-light fallback formalisation of the two pool-membership loops.
It treats the row lookup as an abstract function and places the index-validity
obligation in the domain predicate. This is useful if core `List.getElem?` API
names differ under Lean 4.15.0.
-/

/-- Fixed-to-free differences generated by a list of admissible row indices. -/
def fixedFreePoolFn (row : Nat → Int) (domain : List Nat) (fixed : Int) : List Int :=
  domain.map fun k => row k - fixed

/-- Free-to-free differences generated by two domains, excluding equal row
    indices exactly as in `tmDetect`. -/
def freeFreePoolFn (row : Nat → Int) (left right : List Nat) : List Int :=
  left.flatMap fun k =>
    (right.filter fun l => decide (k ≠ l)).map fun l => row l - row k

theorem fixed_free_mem_pool_fn
    (row : Nat → Int) (domain : List Nat) (fixed : Int)
    (k : Nat) (hk : k ∈ domain) :
    row k - fixed ∈ fixedFreePoolFn row domain fixed := by
  exact List.mem_map.2 ⟨k, hk, rfl⟩

theorem free_free_mem_pool_fn
    (row : Nat → Int) (left right : List Nat)
    (k l : Nat) (hk : k ∈ left) (hl : l ∈ right) (hne : k ≠ l) :
    row l - row k ∈ freeFreePoolFn row left right := by
  apply List.mem_flatMap.2
  refine ⟨k, hk, ?_⟩
  apply List.mem_map.2
  refine ⟨l, ?_, rfl⟩
  simp [hl, hne]

/-- Every realised fixed-to-free completion difference is represented by the
    corresponding mathematical domain pool. -/
theorem fixed_free_completion_membership
    {Completion : Type}
    (row : Completion → Nat → Int)
    (domain : List Nat) (fixed : Int)
    (chosen : Completion → Nat)
    (chosen_mem : ∀ σ, chosen σ ∈ domain) :
    ∀ σ, row σ (chosen σ) - fixed ∈
      fixedFreePoolFn (row σ) domain fixed := by
  intro σ
  exact fixed_free_mem_pool_fn (row σ) domain fixed
    (chosen σ) (chosen_mem σ)

/-- Every realised free-to-free completion difference is represented by the
    Cartesian-domain pool when the two selected rows are distinct. -/
theorem free_free_completion_membership
    {Completion : Type}
    (row : Completion → Nat → Int)
    (left right : List Nat)
    (chosenLeft chosenRight : Completion → Nat)
    (left_mem : ∀ σ, chosenLeft σ ∈ left)
    (right_mem : ∀ σ, chosenRight σ ∈ right)
    (distinct : ∀ σ, chosenLeft σ ≠ chosenRight σ) :
    ∀ σ, row σ (chosenRight σ) - row σ (chosenLeft σ) ∈
      freeFreePoolFn (row σ) left right := by
  intro σ
  exact free_free_mem_pool_fn (row σ) left right
    (chosenLeft σ) (chosenRight σ)
    (left_mem σ) (right_mem σ) (distinct σ)

end Costas32
